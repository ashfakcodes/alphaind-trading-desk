# ===================================================
# BITGET SENTINELDESK AI - CONFIGURATION
# ===================================================

# OpenRouter LLM Settings
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Alternative high-power quant models on OpenRouter:
# OPENROUTER_MODEL=deepseek/deepseek-r1
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Bitget Qwen Fallback LLM API (High-Availability Secondary Provider)
BITGET_QWEN_API_KEY=your_bitget_qwen_api_key_here
BITGET_QWEN_MODEL=qwen3.8-max
BITGET_QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
BITGET_QWEN_WIRE_API=responses

# Bitget API Credentials (Optional for initial demo / sandbox)
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_API_PASSPHRASE=your_bitget_passphrase_here
BITGET_IS_SIMULATION=true

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Desk Risk Limits
MAX_SLIPPAGE_TOLERANCE_PCT=1.5
MAX_LEVERAGE=20
MAX_DRAWDOWN_LIMIT_PCT=10.0
FOMO_SURGE_THRESHOLD_PCT=3.5
REVENGE_TRADING_LOSS_STREAK=3
