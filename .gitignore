# ===================================================
# Alphaind - AI Trading Desk · .gitignore
# ===================================================

# ---------------------------------------------------
# 1. Environment & Sensitive Credentials (CRITICAL)
# ---------------------------------------------------
.env
.env.*
.env*.local
!.env.example
!.env.*.example
backend/.env
backend/.env.*
backend/.env*.local
!backend/.env.example
frontend/.env
frontend/.env.*
frontend/.env*.local
!frontend/.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
*.secret
*.token
secrets/
credentials.json
credentials*.json
bitget_keys.json
scratch/
tmp/
temp/

# ---------------------------------------------------
# 2. Python Bytecode & Cache Only
# ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.mypy_cache/
.pytype/
.ruff_cache/

# ---------------------------------------------------
# 3. Python Virtual Environments & Distribution
# ---------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------------------------------------------------
# 4. Ephemeral Test Caches (Preserving all tests & benchmarks)
# ---------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/
.nox/
.hypothesis/

# Explicitly ensure all test suites, benchmarks, and research data are tracked
!tests/*.py
!tests/**/*.py
!RESEARCH_BRIEF_*.md
!SUBMISSION_WRITEUP.md
!paper_trades_log.csv

# ---------------------------------------------------
# 5. Frontend (Node / Vite / Vercel / Netlify Builds)
# ---------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.vercel
.netlify
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------
# 6. Runtime System Logs & Databases
# ---------------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------
# 7. OS & IDE Generated Files
# ---------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.sublime-project
*.sublime-workspace
.project
.settings/
